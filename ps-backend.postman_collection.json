{
  "info": {
    "_postman_id": "2c2f9504-63d9-46a1-9d4a-ps-backend-api",
    "name": "PS Backend API",
    "description": "Import collection + environment, pilih environment `PS Backend API - Local`, jalankan `Auth / Login`, lalu token otomatis dipakai oleh endpoint protected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (!pm.request.headers.has('Content-Type') && ['POST', 'PUT', 'PATCH'].includes(pm.request.method)) {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Public endpoint. Tidak perlu token."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "url": "{{base_url}}/health"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"API is healthy.\",\n  \"data\": {\n    \"status\": \"ok\",\n    \"timestamp\": \"2026-05-19T11:00:00+00:00\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Login - Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login response is successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json && json.data && json.data.access_token;",
                  "",
                  "pm.test('Access token exists', function () {",
                  "  pm.expect(token, 'data.access_token').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "  if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set('token', token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Jalankan request ini dulu. Script akan menyimpan token ke variable `token`."
          },
          "response": [
            {
              "name": "200 Login Berhasil",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
                },
                "url": "{{base_url}}/auth/login"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Login berhasil.\",\n  \"data\": {\n    \"token_type\": \"Bearer\",\n    \"access_token\": \"1|example-token\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Administrator\",\n      \"email\": \"admin@test.com\"\n    }\n  }\n}"
            },
            {
              "name": "422 Login Gagal",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"wrong@test.com\",\n  \"password\": \"wrong\"\n}"
                },
                "url": "{{base_url}}/auth/login"
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Validasi gagal.\",\n  \"errors\": {\n    \"email\": [\n      \"Email atau password tidak valid.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "description": "Protected endpoint. Header Authorization dibuat otomatis dari Bearer `{{token}}`."
          },
          "response": [
            {
              "name": "200 User",
              "originalRequest": {
                "method": "GET",
                "url": "{{base_url}}/auth/me"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Data user berhasil diambil.\",\n  \"data\": {\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Administrator\",\n      \"email\": \"admin@test.com\"\n    }\n  }\n}"
            },
            {
              "name": "401 Unauthenticated",
              "originalRequest": {
                "method": "GET",
                "url": "{{base_url}}/auth/me"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Unauthenticated.\",\n  \"errors\": null\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": "{{base_url}}/auth/logout"
          },
          "response": [
            {
              "name": "200 Logout",
              "originalRequest": {
                "method": "POST",
                "url": "{{base_url}}/auth/logout"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Logout berhasil.\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "03 Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard/summary"
          }
        }
      ]
    },
